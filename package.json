{
  "name": "pumpmi-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "PORT=3001 python3 scripts/serve.py",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test:api": "python3 scripts/test_api.py",
    "test:ui": "tsx scripts/test_ui.tsx",
    "test:sliders": "tsx scripts/test_slider_concurrency.tsx",
    "test:concurrency": "python3 scripts/test_concurrency.py && python3 scripts/test_transaction_edges.py",
    "test:liveness": "python3 scripts/test_watch_liveness.py",
    "test:entry-status": "tsx scripts/test_entry_status.tsx",
    "test:signals": "python3 scripts/test_signal_analysis.py",
    "test:signal-panel": "tsx scripts/test_signal_panel.tsx",
    "format": "prettier --write src vite.config.ts scripts/test_ui.tsx",
    "start": "python3 scripts/serve.py",
    "test:pump-panel": "tsx scripts/test_pump_panel.tsx",
    "test:pump": "python3 scripts/test_pump_mode.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
